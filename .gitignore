# ==============================================================================
# NARI (Aarogya) - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (NEVER COMMIT SENSITIVE KEYS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/

# ------------------------------------------------------------------------------
# Node.js & Frontend (React / Vite)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / Build outputs
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# ------------------------------------------------------------------------------
# Databases & Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
backend/nari.db
backend/nari.db-journal
backend/nari.db-wal
backend/nari.db-shm
backend/aarogya.db
backend/aarogya.db-journal
backend/aarogya.db-wal
backend/aarogya.db-shm

# User-uploaded files
backend/uploads/*
!backend/uploads/.gitkeep

# ------------------------------------------------------------------------------
# AI Models & Audio Weights (Downloaded at Runtime)
# ------------------------------------------------------------------------------
backend/models/*
!backend/models/.gitkeep
*.onnx
*.onnx.json
.cache/
huggingface/

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
.temp/

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Linux
*~
.directory

# IDEs & Editors
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
