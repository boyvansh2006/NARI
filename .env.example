# ==============================================================================
# NARI (Aarogya) - Environment Configuration
# Agentic AI-Powered Multimodal Women's Health Intelligence Platform
# ==============================================================================

# Application Settings
APP_NAME="NARI Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
MAX_UPLOAD_SIZE_MB=25
REQUEST_TIMEOUT_SECONDS=120

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration
# Default is empty -> uses local SQLite (backend/nari.db)
# For PostgreSQL / Supabase, uncomment and set:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/nari_db"

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Multi-Agent System)
# Provider choices: auto | gemini | openai | groq | mock
# "auto" resolves: Groq -> OpenAI -> Gemini -> Offline Deterministic Mock
# ------------------------------------------------------------------------------
LLM_PROVIDER="auto"

# 1. Google Gemini (Recommended - Free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# 2. OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 3. Groq Cloud
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# 4. Local Ollama (Optional)
OLLAMA_HOST=""
OLLAMA_MODEL=""

# Authentication / Security
JWT_SECRET_KEY="development-insecure-secret-key-change-in-production"

# ------------------------------------------------------------------------------
# Voice Pipeline (Optional - STT & TTS)
# If disabled, STT/TTS gracefully falls back to browser Web Speech API
# ------------------------------------------------------------------------------
# Speech-to-Text (faster-whisper)
WHISPER_MODEL_SIZE="small.en"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# Text-to-Speech (Piper)
# Run `python backend/scripts/download_models.py` to fetch Piper models
# PIPER_VOICE_MODEL="backend/models/piper/en_US-lessac-medium.onnx"
# PIPER_VOICE_CONFIG="backend/models/piper/en_US-lessac-medium.onnx.json"
